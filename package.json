{
  "name": "elonmu.sh",
  "version": "0.2.1",
  "description": "ExpressJS api to fetch a random news article about our Lord and Savior Elon Musk",
  "main": "src/index.ts",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome check --write --linter-enabled=false .",
    "format:check": "biome check --linter-enabled=false .",
    "test": "bun test",
    "check:static": "bun run format:check && bun run lint && bun run typecheck",
    "check": "bun run check:static && bun test"
  },
  "keywords": [
    "funny",
    "satire",
    "gag",
    "api"
  ],
  "author": {
    "email": "nickkelly.858@gmail.com",
    "name": "nickatnight",
    "url": "https://nickkelly.info"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.3.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "^1.4.3",
    "@types/express": "^4.17.17",
    "typescript": "^5.9.3"
  }
}
