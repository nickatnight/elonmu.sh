  "script": [
    "import json, sys",
    "from datetime import datetime, timedelta, timezone",
    "import sgp4, skyfield",
    "from skyfield.api import load, EarthSatellite, wgs84",
    "from skyfield.framelib import itrs",
    "",
    "fixture, out = sys.argv[1], sys.argv[2]",
    "IDS = [45368, 48881, 49133, 54820, 44714]",
    "HOURS = [0, 6, 24]",
    "ts = load.timescale(builtin=True)",
    "records = {r['NORAD_CAT_ID']: r for r in json.load(open(fixture))}",
    "positions = []",
    "for norad in IDS:",
    "    r = records[norad]",
    "    sat = EarthSatellite.from_omm(ts, {k: str(v) for k, v in r.items()})",
    "    epoch = datetime.fromisoformat(r['EPOCH']).replace(tzinfo=timezone.utc)",
    "    epoch_ms = epoch.replace(microsecond=round(epoch.microsecond / 1000) * 1000) if epoch.microsecond < 999500 else epoch.replace(microsecond=0) + timedelta(seconds=1)",
    "    for h in HOURS:",
    "        at = epoch_ms + timedelta(hours=h)",
    "        g = sat.at(ts.from_datetime(at))",
    "        x, y, z = g.frame_xyz(itrs).km",
    "        p = wgs84.geographic_position_of(g)",
    "        positions.append({",
    "            'id': norad, 'name': r['OBJECT_NAME'], 'hoursFromEpoch': h,",
    "            'at': at.isoformat(timespec='milliseconds').replace('+00:00', 'Z'),",
    "            'itrsKm': [round(x, 3), round(y, 3), round(z, 3)],",
    "            'geodetic': {'lat': round(p.latitude.degrees, 4), 'lng': round(p.longitude.degrees, 4), 'altKm': round(p.elevation.km, 3)},",
    "        })",
    "doc = {",
    "    'madeWith': f'Python {sys.version.split()[0]}, sgp4 {sgp4.__version__}, skyfield {skyfield.__version__}',",
    "    'method': 'Each record in tests/fixtures/celestrak-starlink-gp.json was loaded with skyfield EarthSatellite.from_omm (Vallado SGP4, WGS72, BSTAR drag) and propagated to its epoch, rounded to the millisecond, plus 0, 6 and 24 hours. itrsKm is the Earth-fixed ITRS position from frame_xyz(itrs), with UT1 from skyfield\\'s built-in IERS table (load.timescale(builtin=True)). geodetic is the WGS84 sub-point, for reading only.',",
    "    'script': open(__file__).read().splitlines(),",
    "    'positions': positions,",
    "}",
    "json.dump(doc, open(out, 'w'), indent=2)",
    "print(len(positions), 'positions', doc['madeWith'])"
  ],
