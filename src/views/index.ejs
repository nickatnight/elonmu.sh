<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MaaS | Musk as a Service</title>
    <meta name="description" content="A free JSON API that returns a random news article about Elon Musk." />
    <link rel="canonical" href="https://elonmu.sh/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <link rel="stylesheet" href="<%= assets.css %>" />
    <link rel="preload" as="image" href="<%= assets.launch %>" fetchpriority="high" />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://elonmu.sh/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MaaS | Musk as a Service" />
    <meta
      property="og:description"
      content="Access Random News Articles with Our Free Public API - Stay Informed and Ahead of Trends!"
    />
    <meta property="og:image" content="https://elonmu.sh/android-chrome-512x512.png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="elonmu.sh" />
    <meta property="twitter:url" content="https://elonmu.sh/" />
    <meta name="twitter:title" content="MaaS | Musk as a Service" />
    <meta
      name="twitter:description"
      content="Access Random News Articles with Our Free Public API - Stay Informed and Ahead of Trends!"
    />
    <meta name="twitter:image" content="https://elonmu.sh/android-chrome-512x512.png" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <a class="nav__mark" href="/">elonmu.sh</a>
      <nav class="nav__links" aria-label="Primary">
        <a href="https://github.com/nickatnight/elonmu.sh">GitHub</a>
      </nav>
      <a class="button" href="/api">GET /api</a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <h1 class="hero__title" id="hero-title">
          <span class="line"><span>Musk as</span></span>
          <span class="line"><span>a Service</span></span>
        </h1>
        <p class="hero__lead">
          A free JSON API that returns one random news article about our Lord
          and Savior, Elon Musk. /s
        </p>
        <p class="hero__fact">
          <code>GET /api</code> — no key, no signup, no salvation guaranteed.
        </p>
        <figure class="hero__photo">
          <img
            src="<%= assets.launch %>"
            width="900"
            height="1161"
            alt="A Falcon 9 rocket's launch trail arcing up through night clouds over the sea"
            fetchpriority="high"
          />
        </figure>
      </section>
    </main>

    <footer class="footer">
      <div class="footer__cols">
        <div>
          <h2>The parish</h2>
          <ul>
            <li><a href="https://github.com/nickatnight/elonmu.sh">Source on GitHub</a></li>
            <li><a href="https://github.com/nickatnight/elonmu.sh/releases">Releases</a></li>
          </ul>
        </div>
        <div>
          <h2>The readings</h2>
          <ul>
            <li>News via <a href="https://newsapi.org/">NewsAPI.org</a></li>
            <li>One random article per request</li>
          </ul>
        </div>
        <div>
          <h2>Spread the word</h2>
          <ul>
            <li>
              <a
                class="social"
                href="https://www.youtube.com/watch?v=Aq5WXmQQooo"
                aria-label="Facebook"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8z"
                  />
                </svg>
                Facebook
              </a>
            </li>
            <li>
              <a
                class="social"
                href="https://www.youtube.com/watch?v=CdEpmU9pRaE"
                aria-label="X (Twitter)"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"
                  />
                </svg>
                X (Twitter)
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Credits</h2>
          <ul>
            <li>
              Robot icon:
              <a href="https://github.com/twitter/twemoji">Twemoji</a>,
              <a href="https://creativecommons.org/licenses/by/4.0/">CC-BY 4.0</a>
            </li>
            <li>
              Launch photo: Charles Boyer,
              <a href="https://commons.wikimedia.org/w/index.php?curid=123372251">CC BY 2.0</a>
            </li>
          </ul>
        </div>
      </div>
      <svg class="footer__mark" viewBox="0 0 1000 190" role="img" aria-label="elonmu.sh">
        <text x="0" y="150" textLength="1000" lengthAdjust="spacingAndGlyphs">elonmu.sh</text>
      </svg>
      <p class="footer__legal">
        Satire. Not affiliated with Elon Musk or any of his companies. Go in
        peace.
      </p>
    </footer>
  </body>
</html>
