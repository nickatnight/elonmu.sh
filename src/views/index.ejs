<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MaaS | Musk as a Service</title>
    <meta name="description" content="Free, satirical tools about Elon Musk: a random-news JSON API and a year-to-date private-jet tracker." />
    <link rel="canonical" href="https://elonmu.sh/" />

<%- include('partials/head-assets') %>
    <script src="<%= asset('static/js/main.js') %>" defer></script>

<%- include('partials/share-tags', {
  url: 'https://elonmu.sh/',
  title: 'MaaS | Musk as a Service',
  description: 'Enterprise-grade tools for monitoring our Lord and Savior. Random news as JSON, private-jet emissions on a globe. /s'
}) %>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

<%- include('partials/topbar') %>

    <main id="main">
      <section
        class="hero"
        aria-labelledby="hero-title"
        style="--still: url(<%= asset('static/video/clown-cruise-poster.jpg') %>)"
      >
        <%# Plays once; without JS it ends and holds on the space frame. %>
        <video
          class="hero__video hero__video--launch"
          autoplay
          muted
          playsinline
          preload="auto"
          poster="<%= asset('static/video/clown-launch-poster.jpg') %>"
          aria-hidden="true"
        >
          <source src="<%= asset('static/video/clown-launch.webm') %>" type="video/webm" />
          <source src="<%= asset('static/video/clown-launch.mp4') %>" type="video/mp4" />
        </video>
        <%# JS-only: loaded once the launch starts, faded in when it ends. %>
        <video
          class="hero__video hero__video--cruise"
          muted
          loop
          playsinline
          preload="none"
          poster="<%= asset('static/video/clown-cruise-poster.jpg') %>"
          aria-hidden="true"
        >
          <source src="<%= asset('static/video/clown-cruise.webm') %>" type="video/webm" />
          <source src="<%= asset('static/video/clown-cruise.mp4') %>" type="video/mp4" />
        </video>
        <h1 class="hero__title" id="hero-title">
          <span class="line"><span>Musk as</span></span>
          <span class="line"><span>a Service</span></span>
        </h1>
        <p class="hero__lead">
          Enterprise-grade tools for monitoring our Lord and Savior, Elon Musk.
          Random news, private-jet emissions, and whatever we ship next. Free,
          no key, no signup. /s
        </p>
        <a class="hero__cue" href="#services" tabindex="-1" aria-hidden="true">↓</a>
        <button class="hero__toggle" type="button" aria-pressed="false" aria-label="Pause background" hidden>
          <span class="hero__toggle-icon" aria-hidden="true"></span>
        </button>
      </section>

<%- include('partials/services') %>

      <section class="try" id="try" aria-label="Try the News API">
        <figure class="console" data-ui aria-label="Request and response">
          <div class="console__bar">
            <code class="console__method">GET</code>
            <code class="console__url">https://elonmu.sh/api</code>
            <span class="console__status">200 OK · example</span>
            <button class="console__send button" type="button" hidden>
              Send
            </button>
          </div>
          <div class="console__body">
            <article class="card">
              <div class="card__media" hidden></div>
              <p class="card__meta">Example Daily · Oct 22, 2026</p>
              <h2 class="card__title">
                Musk announces plan to announce a plan
              </h2>
              <p class="card__desc">
                Sources close to the announcement say the announcement will be
                announced shortly.
              </p>
              <a class="card__link">Read article →</a>
            </article>
            <pre class="json" translate="no"><code>{
  <span class="tok-key">"source"</span>: <span class="tok-str">"Example Daily"</span>,
  <span class="tok-key">"title"</span>: <span class="tok-str">"Musk announces plan to announce a plan"</span>,
  <span class="tok-key">"description"</span>: <span class="tok-str">"Sources close to…"</span>,
  <span class="tok-key">"url"</span>: <span class="tok-str">"https://example.com/plan"</span>,
  <span class="tok-key">"urlImage"</span>: <span class="tok-str">"https://example.com/plan.jpg"</span>,
  <span class="tok-key">"publishDate"</span>: <span class="tok-str">"2026-10-22T09:00:00Z"</span>
}</code></pre>
          </div>
        </figure>
      </section>

<%- include('partials/jet-teaser', { teaser }) %>

      <section class="doc" id="get-api" aria-labelledby="get-api-title" data-reveal>
        <div class="doc__prose">
          <h2 id="get-api-title"><code>GET /api</code></h2>
          <p>
            Returns one random English-language news article about Elon Musk,
            picked from the latest page of NewsAPI results. No parameters, no
            headers, no API key.
          </p>
          <h3>Response fields</h3>
          <table class="fields">
            <thead>
              <tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Description</th></tr>
            </thead>
            <tbody>
              <tr><td><code>source</code></td><td>string</td><td>Publication name</td></tr>
              <tr><td><code>title</code></td><td>string</td><td>Headline</td></tr>
              <tr><td><code>description</code></td><td>string | null</td><td>Summary from the publisher</td></tr>
              <tr><td><code>url</code></td><td>string</td><td>Link to the full article</td></tr>
              <tr><td><code>urlImage</code></td><td>string | null</td><td>Lead image URL</td></tr>
              <tr><td><code>publishDate</code></td><td>string</td><td>ISO 8601 timestamp</td></tr>
            </tbody>
          </table>
        </div>
        <div class="doc__code">
          <figure class="code" data-ui>
            <figcaption>Request <button class="copy" type="button" hidden>Copy</button></figcaption>
            <pre translate="no"><code>curl https://elonmu.sh/api</code></pre>
          </figure>
          <figure class="code" data-ui>
            <figcaption>Response · 200 <button class="copy" type="button" hidden>Copy</button></figcaption>
            <pre data-example="response" translate="no"><code>{
  <span class="tok-key">"source"</span>: <span class="tok-str">"Business Insider"</span>,
  <span class="tok-key">"title"</span>: <span class="tok-str">"Elon Musk's 10 most colorful quotes from Tesla's investor day"</span>,
  <span class="tok-key">"description"</span>: <span class="tok-str">"Musk joked about charging mishaps."</span>,
  <span class="tok-key">"url"</span>: <span class="tok-str">"https://example.com/elon-musk-investor-day"</span>,
  <span class="tok-key">"urlImage"</span>: <span class="tok-str">"https://example.com/elon.jpg"</span>,
  <span class="tok-key">"publishDate"</span>: <span class="tok-str">"2023-03-02T11:37:41Z"</span>
}</code></pre>
          </figure>
        </div>
      </section>

      <section class="doc" id="errors" aria-labelledby="errors-title" data-reveal>
        <div class="doc__prose">
          <h2 id="errors-title">Errors</h2>
          <p>
            Errors come back as JSON with a single <code>error</code> message.
            When NewsAPI is down or unreachable, the status is still 200: we are
            fine, it is the news that failed. Our own mistakes are a 500.
          </p>
          <table class="fields">
            <thead>
              <tr><th scope="col">Status</th><th scope="col">When</th></tr>
            </thead>
            <tbody>
              <tr><td><code>200</code></td><td>NewsAPI returned an error or never answered</td></tr>
              <tr><td><code>500</code></td><td>Something broke on our side</td></tr>
              <tr><td><code>404</code></td><td>Any other path. The body is plain text: <code>does not compute...</code></td></tr>
            </tbody>
          </table>
        </div>
        <div class="doc__code">
          <figure class="code" data-ui>
            <figcaption>Response · 200 <button class="copy" type="button" hidden>Copy</button></figcaption>
            <pre translate="no"><code>{
  <span class="tok-key">"error"</span>: <span class="tok-str">"There was an error with NewsAPI. Please try again later."</span>
}</code></pre>
          </figure>
          <figure class="illus">
            <img
              src="<%= asset('static/img/rud.jpg') %>"
              width="960"
              height="536"
              alt="A rocket breaking apart mid-flight"
              loading="lazy"
            />
            <figcaption>Fig. 1: a 500, in production.</figcaption>
          </figure>
        </div>
      </section>
      <section class="praise" id="testimonials" aria-labelledby="testimonials-title" data-reveal>
        <h2 id="testimonials-title">What developers are saying</h2>
        <figure class="praise__lead">
          <blockquote>
            <p>We replaced our news team with a single curl. Morale is down, but uptime is divine.</p>
          </blockquote>
          <figcaption>Priya Null, CTO at a Series Z startup</figcaption>
        </figure>
        <img
          class="praise__portrait"
          src="<%= asset('static/img/testimonials/priya.jpg') %>"
          width="640"
          height="640"
          alt=""
          loading="lazy"
        />
        <figure class="praise__quote">
          <img src="<%= asset('static/img/testimonials/sam.jpg') %>" width="80" height="80" alt="" loading="lazy" />
          <blockquote>
            <p>I asked for one random article and received exactly one random article. I have never felt so seen.</p>
          </blockquote>
          <figcaption>Sam Segfault, weekend developer</figcaption>
        </figure>
        <figure class="praise__quote">
          <img src="<%= asset('static/img/testimonials/jordan.jpg') %>" width="80" height="80" alt="" loading="lazy" />
          <blockquote>
            <p>No key, no signup, no SDK. Ten out of ten, would <code>GET</code> again.</p>
          </blockquote>
          <figcaption>Jordan Byte, staff engineer at Hypothetical Corp</figcaption>
        </figure>
      </section>
      <p class="sr-only announce" aria-live="polite"></p>
    </main>

    <footer class="footer">
      <div>
        <h2>Project</h2>
        <ul>
          <li><a href="https://github.com/nickatnight/elonmu.sh">Source on GitHub</a></li>
          <li><a href="https://github.com/nickatnight/elonmu.sh/releases">Releases</a></li>
        </ul>
      </div>
      <div>
        <h2>Follow</h2>
        <ul>
          <li>
            <a
              class="social"
              href="https://www.youtube.com/watch?v=Aq5WXmQQooo"
              aria-label="Facebook"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8z"
                />
              </svg>
              Facebook
            </a>
          </li>
          <li>
            <a
              class="social"
              href="https://www.youtube.com/watch?v=CdEpmU9pRaE"
              aria-label="X (Twitter)"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"
                />
              </svg>
              X (Twitter)
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h2>Credits</h2>
        <ul>
          <li>News via <a href="https://newsapi.org/">NewsAPI.org</a></li>
          <li>Flights via <a href="https://bsky.app/profile/elonjet.net" rel="noopener noreferrer">@elonjet.net</a> by Jack Sweeney</li>
          <li>Portraits and illustration: AI-generated. The people are fictional.</li>
        </ul>
      </div>
      <p class="footer__legal">
        Satire. Not affiliated with Elon Musk or any of his companies.
      </p>
    </footer>
  </body>
</html>
