      <section class="services" id="services" aria-labelledby="services-title" data-reveal>
        <div class="services__head">
          <h2 id="services-title">Services</h2>
          <p class="services__sub">Our product suite. All free, all unsolicited.</p>
        </div>
        <ul class="services__grid" role="list">
<% for (const service of services) { -%>
          <li>
            <article class="service">
              <h3 class="service__name"><a class="service__link" href="<%= service.href %>"><%= service.name %></a></h3>
              <p class="service__summary"><%= service.summary %></p>
              <span class="service__cta"><%= service.cta %> <span class="service__arrow" aria-hidden="true">→</span></span>
              <a class="service__endpoint" href="/docs#<%= service.id %>"><code>GET <%= service.api %></code> <span>docs</span></a>
            </article>
          </li>
<% } -%>
          <li>
            <div class="service service--soon">
              <h3 class="service__name">More soon</h3>
              <p class="service__summary">Shipping next quarter. Which quarter is unspecified.</p>
            </div>
          </li>
        </ul>
      </section>
