<%# Shared top bar: one link per catalog entry, then GitHub. `current` is the
    id of the service whose page this is (omitted on home). %>
    <header class="topbar">
      <a class="brand" href="/" translate="no">
        <img src="<%= asset('favicon-32x32.png') %>" width="20" height="20" alt="" />
        elonmu.sh
      </a>
      <nav class="topbar__actions" aria-label="Primary">
<% for (const service of services) { -%>
        <a href="<%= service.href %>"<%- service.id === locals.current ? ' aria-current="page"' : '' %>><%= service.nav %></a>
<% } -%>
        <a class="topbar__extra" href="https://github.com/nickatnight/elonmu.sh">GitHub<svg class="topbar__out" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false"><path d="M4 2h6v6M10 2 2 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </nav>
    </header>
