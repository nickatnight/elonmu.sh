    <header class="topbar">
      <a class="brand" href="/" translate="no">
        <img src="<%= asset('favicon-32x32.png') %>" width="20" height="20" alt="" />
        <span class="brand__name">elonmu.sh</span>
      </a>
      <nav class="topbar__actions" aria-label="Primary">
<% for (const service of services) { -%>
        <a href="<%= service.href %>"<%- service.id === locals.current ? ' aria-current="page"' : '' %>><%= service.nav %></a>
<% } -%>
        <a href="/docs"<%- locals.current === 'docs' ? ' aria-current="page"' : '' %>>Docs</a>
      </nav>
      <a class="ribbon" href="https://github.com/nickatnight/elonmu.sh" target="_blank" rel="noopener noreferrer"><span class="ribbon__band">Fork me, Daddy /s<span class="sr-only"> (source on GitHub, opens in a new tab)</span></span></a>
    </header>
