<%# Open Graph and Twitter tags. `url`, `title` and `description` are the
    page's own; every page shares the site card, og.png. %>
    <meta property="og:url" content="<%= url %>" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="https://elonmu.sh<%= asset('og.png') %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Musk as a Service: enterprise-grade tools for monitoring our Lord and Savior. News API, Jet tracker, and more soon." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="elonmu.sh" />
    <meta property="twitter:url" content="<%= url %>" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta name="twitter:image" content="https://elonmu.sh<%= asset('og.png') %>" />
